*.pyc
*.pt
outputs/**
.env
data/**
slconf/**
.commands_auto.sh
.pytest_cache/**
# Old-vs-new checks against the paper's original code; they need that codebase and its records.
migration_tests/**

# Experiment runtime files and bulk artifacts stay in persistent artifact storage.
/fork_experiments/**/*.log
/fork_experiments/**/*.log.gz
/fork_experiments/**/*.pid
/fork_experiments/**/pid
/fork_experiments/**/*.lock
!/fork_experiments/**/uv.lock
/fork_experiments/**/*.tmp
/fork_experiments/**/*.part[0-9]*
/fork_experiments/**/*.tar
/fork_experiments/**/*.tar.gz
/fork_experiments/**/*.tgz
/fork_experiments/**/*.bundle
/fork_experiments/**/*.parquet
/fork_experiments/**/results/**/*.jsonl
/fork_experiments/**/watcher_status.json
/fork_experiments/**/results/**/state.json
/fork_experiments/**/results/**/guard.json
/fork_experiments/**/results/**/budget.json
